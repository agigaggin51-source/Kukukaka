<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chess Master - Stockfish Analysis & Brilliant Moves</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chess.js library for rule validation & FEN/PGN generation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        chessDark: '#262421',
                        chessDarker: '#1e1c18',
                        chessPanel: '#312e2b',
                        chessPanelLight: '#3a3734',
                        chessGreenDark: '#769656',
                        chessGreenLight: '#eeeed2',
                        chessWoodDark: '#b58863',
                        chessWoodLight: '#f0d9b5',
                        chessBlueDark: '#4a75a0',
                        chessBlueLight: '#c4d7e6',
                        chessAccent: '#81b64c',
                        chessAccentHover: '#a3d168',
                        brilliantTeal: '#26c2a3'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #161512;
            color: #bababa;
            user-select: none;
            overflow-x: hidden;
        }

        .board-container {
            position: relative;
            width: 100%;
            height: 100%;
            aspect-ratio: 1 / 1;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            grid-template-rows: repeat(8, 1fr);
        }

        .square {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color 0.15s ease;
            cursor: pointer;
            width: 100%;
            height: 100%;
        }

        .square-label {
            position: absolute;
            font-size: 10px;
            font-weight: bold;
            pointer-events: none;
            z-index: 2;
        }

        .rank-label { top: 2px; left: 2px; }
        .file-label { bottom: 2px; right: 2px; }

        /* Move indicators */
        .legal-dot {
            width: 28%;
            height: 28%;
            border-radius: 50%;
            background-color: rgba(0, 0, 0, 0.25);
            pointer-events: none;
            z-index: 15;
        }

        .legal-capture-ring {
            width: 90%;
            height: 90%;
            border-radius: 50%;
            border: 6px solid rgba(0, 0, 0, 0.25);
            pointer-events: none;
            z-index: 15;
        }

        .last-move-highlight {
            background-color: rgba(255, 255, 51, 0.4) !important;
        }

        .selected-square {
            background-color: rgba(20, 85, 30, 0.5) !important;
        }

        .check-highlight {
            background-color: rgba(255, 0, 0, 0.55) !important;
        }

        /* Chess Piece Elements */
        .piece {
            width: 90%;
            height: 90%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: grab;
            z-index: 10;
            pointer-events: auto;
            transition: transform 0.1s ease;
        }

        .piece svg {
            width: 100%;
            height: 100%;
            filter: drop-shadow(0px 3px 3px rgba(0, 0, 0, 0.4));
        }

        .piece.dragging {
            cursor: grabbing;
            opacity: 0.7;
            transform: scale(1.1);
        }

        /* Custom Scrollbar for Move List */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #21201d; }
        ::-webkit-scrollbar-thumb { background: #403d39; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #524f4a; }

        /* Eval Bar */
        .eval-bar-container {
            width: 20px;
            height: 100%;
            background-color: #312e2b;
            border-radius: 4px;
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .eval-bar-white {
            background-color: #e2e2e2;
            width: 100%;
            transition: height 0.4s ease-out;
        }

        .eval-bar-black {
            background-color: #262421;
            width: 100%;
            flex-grow: 1;
        }

        .eval-text {
            position: absolute;
            width: 100%;
            text-align: center;
            font-size: 10px;
            font-weight: 800;
            z-index: 2;
            left: 0;
        }

        .tab-btn.active {
            border-bottom: 3px solid #81b64c;
            color: #ffffff;
            background-color: rgba(255,255,255,0.05);
        }

        /* Move Classification Badges */
        .badge-brilliant { background-color: #26c2a3; color: #0f3830; }
        .badge-great { background-color: #5c8bb0; color: #ffffff; }
        .badge-best { background-color: #81b64c; color: #1c3308; }
        .badge-excellent { background-color: #96bc4b; color: #22330a; }
        .badge-good { background-color: #a8b88a; color: #232918; }
        .badge-inaccuracy { background-color: #f0c15c; color: #423004; }
        .badge-mistake { background-color: #e68f43; color: #3d1c02; }
        .badge-blunder { background-color: #ca3431; color: #ffffff; }

        /* Brilliant Glow Animation */
        @keyframes brilliantGlow {
            0% { box-shadow: 0 0 5px #26c2a3; }
            50% { box-shadow: 0 0 25px #26c2a3, 0 0 35px #26c2a3; }
            100% { box-shadow: 0 0 5px #26c2a3; }
        }

        .brilliant-square-highlight {
            animation: brilliantGlow 1.5s infinite;
            background-color: rgba(38, 194, 163, 0.4) !important;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- Header Navigation -->
    <header class="bg-chessDark border-b border-neutral-800 px-4 py-2.5 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2 text-chessAccent font-bold text-xl tracking-wide">
                <i class="fa-solid fa-chess-knight text-2xl"></i>
                <span class="text-white">W <span class="text-chessAccent">Chess</span></span>
            </div>
            <span class="bg-neutral-800 text-xs px-2 py-0.5 rounded text-neutral-400 font-mono hidden sm:inline-block">Stockfish + Opening Guide</span>
        </div>

        <!-- Mode Select Buttons -->
        <div class="flex items-center gap-1 sm:gap-2 bg-chessDarker p-1 rounded-lg border border-neutral-800">
            <button id="mode-vs-ai" onclick="switchGameMode('vs-ai')" class="px-3 py-1.5 rounded-md text-xs sm:text-sm font-semibold transition flex items-center gap-1.5 bg-chessPanel text-white shadow">
                <i class="fa-solid fa-robot text-chessAccent"></i> <span class="hidden md:inline">vs</span> Computer
            </button>
            <button id="mode-pass-play" onclick="switchGameMode('pass-play')" class="px-3 py-1.5 rounded-md text-xs sm:text-sm font-semibold transition flex items-center gap-1.5 text-neutral-400 hover:text-white">
                <i class="fa-solid fa-users"></i> Pass & Play
            </button>
            <button id="mode-analysis" onclick="switchGameMode('analysis')" class="px-3 py-1.5 rounded-md text-xs sm:text-sm font-semibold transition flex items-center gap-1.5 text-neutral-400 hover:text-white">
                <i class="fa-solid fa-microchip text-blue-400"></i> Analysis Board
            </button>
        </div>

        <div class="flex items-center gap-2">
            <button onclick="setActiveTab('settings')" class="p-2 text-neutral-400 hover:text-white rounded-lg hover:bg-neutral-800 transition" title="Settings">
                <i class="fa-solid fa-gear text-lg"></i>
            </button>
        </div>
    </header>

    <!-- Main Game Area -->
    <main class="flex-grow flex flex-col lg:flex-row items-center lg:items-stretch justify-center gap-4 p-2 sm:p-4 max-w-7xl mx-auto w-full">
        
        <!-- Board Column -->
        <div class="flex flex-col items-center justify-center w-full max-w-[680px]">
            
            <!-- Top Player Box (Black) -->
            <div class="w-full bg-chessPanel rounded-t-lg p-2.5 flex items-center justify-between border-b border-neutral-700/50">
                <div class="flex items-center gap-3">
                    <div class="relative">
                        <div id="black-avatar" class="w-10 h-10 rounded bg-neutral-700 flex items-center justify-center font-bold text-white shadow">
                            <i class="fa-solid fa-robot text-xl text-neutral-300"></i>
                        </div>
                        <span id="black-turn-indicator" class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-chessAccent rounded-full border-2 border-chessPanel hidden"></span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span id="black-name" class="font-bold text-sm text-white">Stockfish AI</span>
                            <span id="black-rating" class="text-xs bg-neutral-800 text-neutral-400 px-1.5 py-0.5 rounded font-mono">Level 3</span>
                        </div>
                        <div id="black-captured" class="flex items-center gap-0.5 h-4 mt-0.5 text-xs text-neutral-400"></div>
                    </div>
                </div>
                <div id="black-timer" class="bg-chessDarker px-3 py-1 rounded font-mono font-bold text-lg text-neutral-200 border border-neutral-700 shadow-inner">
                    05:00
                </div>
            </div>

            <!-- Board + Eval Bar Container -->
            <div class="flex w-full gap-2 my-1 min-h-[300px] max-h-[600px]">
                <!-- Stockfish Eval Bar -->
                <div class="eval-bar-container shadow-md flex-shrink-0" title="Evaluation Bar">
                    <span id="eval-text-top" class="eval-text top-1 text-black font-mono">0.0</span>
                    <div id="eval-bar-black" class="eval-bar-black"></div>
                    <div id="eval-bar-white" class="eval-bar-white" style="height: 50%;"></div>
                    <span id="eval-text-bottom" class="eval-text bottom-1 text-white font-mono"></span>
                </div>

                <!-- Main Board Canvas -->
                <div id="board" class="board-container rounded overflow-hidden select-none flex-grow">
                    <!-- 64 Squares render dynamically -->
                </div>
            </div>

            <!-- Bottom Player Box (White) -->
            <div class="w-full bg-chessPanel rounded-b-lg p-2.5 flex items-center justify-between border-t border-neutral-700/50">
                <div class="flex items-center gap-3">
                    <div class="relative">
                        <div id="white-avatar" class="w-10 h-10 rounded bg-neutral-200 flex items-center justify-center font-bold text-neutral-900 shadow">
                            <i class="fa-solid fa-user text-xl text-neutral-700"></i>
                        </div>
                        <span id="white-turn-indicator" class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-chessAccent rounded-full border-2 border-chessPanel"></span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span id="white-name" class="font-bold text-sm text-white">You</span>
                            <span id="white-rating" class="text-xs bg-neutral-800 text-neutral-400 px-1.5 py-0.5 rounded font-mono">1500</span>
                        </div>
                        <div id="white-captured" class="flex items-center gap-0.5 h-4 mt-0.5 text-xs text-neutral-400"></div>
                    </div>
                </div>
                <div id="white-timer" class="bg-chessDarker px-3 py-1 rounded font-mono font-bold text-lg text-white border border-neutral-700 shadow-inner">
                    05:00
                </div>
            </div>

        </div>

        <!-- Sidebar Panel -->
        <div class="w-full lg:w-96 bg-chessPanel rounded-lg flex flex-col border border-neutral-700/60 shadow-xl h-[500px] lg:h-[700px]">
            
            <div class="flex border-b border-neutral-700/80 bg-chessDarker rounded-t-lg">
                <button onclick="setActiveTab('moves')" id="tab-moves" class="tab-btn active flex-1 py-3 text-xs font-bold uppercase tracking-wider text-neutral-400 transition hover:text-white flex items-center justify-center gap-2">
                    <i class="fa-solid fa-list-ol"></i> Moves
                </button>
                <button onclick="setActiveTab('analysis')" id="tab-analysis" class="tab-btn flex-1 py-3 text-xs font-bold uppercase tracking-wider text-neutral-400 transition hover:text-white flex items-center justify-center gap-2">
                    <i class="fa-solid fa-chart-line"></i> Engine
                </button>
                <button onclick="setActiveTab('settings')" id="tab-settings" class="tab-btn flex-1 py-3 text-xs font-bold uppercase tracking-wider text-neutral-400 transition hover:text-white flex items-center justify-center gap-2">
                    <i class="fa-solid fa-sliders"></i> Setup
                </button>
            </div>

            <!-- Tab 1: Moves List -->
            <div id="panel-moves" class="flex-grow flex flex-col p-3 overflow-hidden">
                <div id="game-status-banner" class="bg-chessDarker border border-neutral-700 rounded-lg p-3 mb-3 text-center">
                    <span id="status-text" class="text-sm font-semibold text-chessAccent">White's Turn to Move</span>
                    <div id="engine-status" class="text-xs text-neutral-400 mt-0.5 flex items-center justify-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Stockfish Engine Active
                    </div>
                </div>

                <!-- Dynamic Opening Display Box -->
                <div id="opening-card" class="bg-chessDarker border border-chessAccent/40 rounded-lg p-3 mb-3 flex flex-col gap-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-chessAccent flex items-center gap-1">
                            <i class="fa-solid fa-book-open"></i> Pembukaan Catur (Opening)
                        </span>
                        <span id="opening-eco" class="text-[10px] bg-neutral-800 text-neutral-300 font-mono px-1.5 py-0.5 rounded">C20</span>
                    </div>
                    <div id="opening-title" class="text-sm font-bold text-white">Pembukaan Pion Raja</div>
                    <p id="opening-desc" class="text-xs text-neutral-300 leading-snug">
                        Langkah awal 1. e4 mengontrol petak pusat d5 dan e5, serta membuka jalur kembang untuk Menteri dan Gajah Sayap Raja.
                    </p>
                </div>

                <div class="flex-grow overflow-y-auto bg-chessDarker rounded-lg border border-neutral-700/50 p-2 font-mono text-sm">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-neutral-500 border-b border-neutral-800 text-xs uppercase">
                                <th class="pb-1 pl-2 w-10">#</th>
                                <th class="pb-1">White</th>
                                <th class="pb-1">Black</th>
                            </tr>
                        </thead>
                        <tbody id="move-history-tbody"></tbody>
                    </table>
                </div>

                <div class="grid grid-cols-2 gap-2 mt-3 pt-2 border-t border-neutral-700/60">
                    <button onclick="resetGame()" class="py-2 bg-chessAccent hover:bg-chessAccentHover text-chessDark font-bold rounded transition text-sm flex items-center justify-center gap-2 shadow">
                        <i class="fa-solid fa-rotate-right"></i> New Game
                    </button>
                    <button onclick="flipBoard()" class="py-2 bg-chessDarker hover:bg-neutral-700 text-white font-semibold rounded transition text-sm flex items-center justify-center gap-2 border border-neutral-700">
                        <i class="fa-solid fa-arrows-rotate"></i> Flip Board
                    </button>
                </div>
            </div>

            <!-- Tab 2: Stockfish Engine Analysis -->
            <div id="panel-analysis" class="flex-grow flex flex-col p-3 overflow-y-auto hidden">
                <div class="bg-chessDarker p-3 rounded-lg border border-neutral-700 mb-3">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-bold uppercase text-neutral-400">Stockfish Engine 10</span>
                        <span id="analysis-depth" class="text-xs font-mono bg-neutral-800 text-chessAccent px-2 py-0.5 rounded">Depth: --</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="text-2xl font-bold font-mono text-white" id="analysis-eval">0.00</div>
                        <div class="text-xs text-neutral-400 leading-tight">
                            Best Line:<br>
                            <span id="analysis-bestline" class="font-mono text-chessAccent font-semibold">Ready</span>
                        </div>
                    </div>
                </div>

                <button onclick="runFullGameAnalysis()" id="btn-run-analysis" class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded shadow transition text-sm mb-3 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Analyze Game Quality
                </button>

                <div id="analysis-summary" class="hidden flex-grow flex flex-col gap-2">
                    <span class="text-xs font-bold uppercase text-neutral-400 mb-1">Move Quality Breakdown</span>
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <div class="bg-chessDarker p-2 rounded border border-neutral-800 flex justify-between items-center">
                            <span><i class="fa-solid fa-gem text-brilliantTeal mr-1"></i> Brilliant (!!)</span>
                            <span id="count-brilliant" class="font-mono font-bold text-brilliantTeal">0</span>
                        </div>
                        <div class="bg-chessDarker p-2 rounded border border-neutral-800 flex justify-between items-center">
                            <span><i class="fa-solid fa-circle text-emerald-500 text-[10px] mr-1"></i> Best</span>
                            <span id="count-best" class="font-mono font-bold text-white">0</span>
                        </div>
                        <div class="bg-chessDarker p-2 rounded border border-neutral-800 flex justify-between items-center">
                            <span><i class="fa-solid fa-circle text-blue-500 text-[10px] mr-1"></i> Excellent</span>
                            <span id="count-excellent" class="font-mono font-bold text-white">0</span>
                        </div>
                        <div class="bg-chessDarker p-2 rounded border border-neutral-800 flex justify-between items-center">
                            <span><i class="fa-solid fa-circle text-yellow-500 text-[10px] mr-1"></i> Inaccuracy</span>
                            <span id="count-inaccuracy" class="font-mono font-bold text-white">0</span>
                        </div>
                        <div class="bg-chessDarker p-2 rounded border border-neutral-800 flex justify-between items-center">
                            <span><i class="fa-solid fa-circle text-orange-500 text-[10px] mr-1"></i> Mistake</span>
                            <span id="count-mistake" class="font-mono font-bold text-white">0</span>
                        </div>
                        <div class="bg-chessDarker p-2 rounded border border-neutral-800 flex justify-between items-center">
                            <span><i class="fa-solid fa-circle text-red-500 text-[10px] mr-1"></i> Blunder</span>
                            <span id="count-blunder" class="font-mono font-bold text-white">0</span>
                        </div>
                    </div>
                </div>

                <div class="mt-auto pt-3 border-t border-neutral-700/60">
                    <span class="text-xs font-bold uppercase text-neutral-400 block mb-1">PGN Data</span>
                    <textarea id="pgn-input" rows="3" class="w-full bg-chessDarker border border-neutral-700 rounded p-2 text-xs font-mono text-neutral-300 focus:outline-none focus:border-chessAccent resize-none" placeholder="Paste PGN here..."></textarea>
                    <div class="flex gap-2 mt-2">
                        <button onclick="importPGN()" class="flex-1 py-1.5 bg-neutral-700 hover:bg-neutral-600 text-white rounded text-xs font-semibold">Import PGN</button>
                        <button onclick="exportPGN()" class="flex-1 py-1.5 bg-neutral-700 hover:bg-neutral-600 text-white rounded text-xs font-semibold">Copy PGN</button>
                    </div>
                </div>
            </div>

            <!-- Tab 3: Settings -->
            <div id="panel-settings" class="flex-grow flex flex-col p-4 overflow-y-auto hidden gap-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-neutral-400 mb-1">Stockfish Level</label>
                    <select id="ai-difficulty" onchange="updateDifficulty()" class="w-full bg-chessDarker border border-neutral-700 rounded p-2 text-sm text-white focus:outline-none focus:border-chessAccent">
                        <option value="1">Level 1 - Easy (Depth 1)</option>
                        <option value="3" selected>Level 2 - Casual (Depth 3)</option>
                        <option value="5">Level 3 - Medium (Depth 5)</option>
                        <option value="8">Level 4 - Hard (Depth 8)</option>
                        <option value="12">Level 5 - Expert (Depth 12)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase text-neutral-400 mb-1">Play Side</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button id="btn-play-white" onclick="setUserSide('w')" class="py-2 bg-chessAccent text-chessDark font-bold rounded text-xs">White</button>
                        <button id="btn-play-black" onclick="setUserSide('b')" class="py-2 bg-chessDarker text-white font-bold rounded text-xs border border-neutral-700">Black</button>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase text-neutral-400 mb-1">Board Theme</label>
                    <select id="board-theme-select" onchange="changeBoardTheme(this.value)" class="w-full bg-chessDarker border border-neutral-700 rounded p-2 text-sm text-white focus:outline-none focus:border-chessAccent">
                        <option value="green">Chess.com Green</option>
                        <option value="wood">Classic Wood</option>
                        <option value="blue">Ocean Blue</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase text-neutral-400 mb-1">Time Limit</label>
                    <select id="time-control-select" onchange="changeTimeControl(this.value)" class="w-full bg-chessDarker border border-neutral-700 rounded p-2 text-sm text-white focus:outline-none focus:border-chessAccent">
                        <option value="1">1 Minute Bullet</option>
                        <option value="3">3 Minutes Blitz</option>
                        <option value="5" selected>5 Minutes Blitz</option>
                        <option value="10">10 Minutes Rapid</option>
                        <option value="0">Unlimited Time</option>
                    </select>
                </div>

                <div class="flex items-center justify-between border-t border-neutral-700 pt-3">
                    <span class="text-sm font-semibold text-neutral-200">Sound Effects</span>
                    <input type="checkbox" id="sound-toggle" checked class="w-4 h-4 accent-chessAccent cursor-pointer">
                </div>
            </div>

        </div>

    </main>

    <!-- Modal for Brilliant Move Explanation -->
    <div id="brilliant-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden transition-opacity">
        <div class="bg-chessPanel border-2 border-brilliantTeal rounded-xl p-6 max-w-md w-full shadow-2xl relative transform transition-all scale-95">
            <button onclick="closeBrilliantModal()" class="absolute top-3 right-3 text-neutral-400 hover:text-white text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-full bg-brilliantTeal/20 border border-brilliantTeal flex items-center justify-center text-brilliantTeal text-2xl shadow-lg">
                    <i class="fa-solid fa-gem"></i>
                </div>
                <div>
                    <h3 class="text-xl font-extrabold text-white flex items-center gap-2">
                        Brilliant Move!!
                        <span class="text-xs bg-brilliantTeal text-chessDark px-2 py-0.5 rounded font-mono font-bold">!!</span>
                    </h3>
                    <p class="text-xs text-neutral-400">Stockfish Game Analysis Engine</p>
                </div>
            </div>

            <div class="bg-chessDarker p-4 rounded-lg border border-neutral-700/80 mb-4">
                <p id="brilliant-explanation-text" class="text-sm text-neutral-200 leading-relaxed">
                    You sacrificed a piece (Knight or Bishop) to force a tactical advantage, winning material back or building an unstoppable king attack!
                </p>
            </div>

